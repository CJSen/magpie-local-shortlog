{
  "name": "magpie-local-shortlog",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local shortlog for the magpie gateway: what the user asked, what the model answered, prompts included, tools and tool output stripped. One append-only file rotated at 20MB, never leaves this machine.",
  "license": "MIT",
  "keywords": ["magpie", "magpie-plugin", "shortlog", "conversation", "local", "local-only"],
  "magpie": {
    "hooks": "./src/hooks.ts",
    "options": {
      "enabled": false,
      "file": "conversations.log",
      "dir": "",
      "format": "text",
      "maxFileMB": 20,
      "keepFiles": 5,
      "origins": ["local"],
      "skipPaths": ["/v1/messages/count_tokens", "/v1/models", "/v1beta/models"],
      "skipAux": true,
      "showToolCalls": true,
      "showReasoning": false,
      "maxTextKB": 256,
      "systemReprintHours": 6,
      "redactKeys": [],
      "debug": false
    }
  },
  "files": ["src", "README.md"]
}
